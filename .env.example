# Weca Offroad Centre - Environment Variables
# Copy this file to `.env` and adjust values as needed.

# Prisma database URL (SQLite by default)
# Use a relative path so it works on any dev machine
DATABASE_URL="file:./db/custom.db"

# Set to "production" when deploying
# NODE_ENV="production"

# NextAuth.js (only needed if you enable authentication)
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET="generate with: openssl rand -base64 32"
